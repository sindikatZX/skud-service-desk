# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://fsm:change_me@db:5432/fsm
# Секрет для подписи JWT-сессий: не короче 32 символов, иначе в production вход отключён
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_string
# Пароль демо-пользователей при первом запуске (сид выполняется только на пустой БД)
SEED_PASSWORD=password
# Если приложение работает по HTTP без TLS (не рекомендуется), разрешить cookie без Secure
COOKIE_SECURE=true
# Порт приложения
PORT=3000

# ─── Примечание по безопасности ───
# POSTGRES_PASSWORD и AUTH_SECRET обязательны: docker compose не запустится,
# если они не заданы (раньше подставлялся небезопасный дефолт change_me).

# Показывать демо-доступы на странице входа. В production они скрыты, пока здесь не стоит true
SHOW_DEMO_LOGINS=false

# Каталог для вложений чата (вне public/). В Docker смонтируйте том на этот путь.
UPLOAD_DIR=./uploads
# Максимальный размер одного файла вложения, МБ
MAX_UPLOAD_MB=50
